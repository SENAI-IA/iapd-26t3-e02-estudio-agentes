# Copie para .env e preencha só as IAs que quiser usar por API.
#   cp .env.example .env
#
# Com a chave preenchida, o agente usa a API oficial da IA (cobrança por uso).
# Com a chave vazia, ele usa a CLI logada na sua assinatura (claude / gemini / codex).
# O .env é relido a cada pedido: não precisa reiniciar o app.

# Maestro, Pixel e Chevron — https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Scout — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Revisor — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
